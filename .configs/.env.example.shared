# ==============================================================================
# Repository Settings
# ==============================================================================
# DESTinY repository API endpoint
BASE_URL=https://api.staging.evidence-repository.org

# The environment this robot is deployed in
# Allowed values: local, development, staging, production, test
ENV=staging

# ==============================================================================
# Robot Looping Settings
# ==============================================================================
# How long to sleep between each loop (in seconds)
INTERVAL_SECONDS=30

# The number of references to include per batch
BATCH_SIZE=10

# Processing the full enhancement batch at once might consume too much RAM, so we will process the data in smaller batches of this size.
BATCH_SIZE_PREFILTER=10

# ==============================================================================
# Config Files & Paths
# ==============================================================================
# Path to file containing search query
SEARCH_QUERY=.configs/search-query.txt

# Path to serialised sklearn model
MODEL_PREFILTER=.configs/models/high-recall-svm.sklearn

# Path to prompt/model config for high-recall LLM
PROMPT_HIGH_RECALL=.configs/prompts/high_recall.txt

# Path to prompt/model config for balanced LLM
PROMPT_BALANCED=.configs/prompts/balanced.txt

# Path to prompt/model config for high-precision LLM
PROMPT_HIGH_PRECISION=.configs/prompts/high_precision.txt

# ==============================================================================
# LLM Provider Settings
# ==============================================================================
# Azure OpenAI API key if using Azure provider
LLM_AZURE_API_KEY=your-azure-api-key-here

# Base URL for azure openAI
LLM_AZURE_API_BASE=https://your-resource-name.openai.azure.com/

# Maximum number of context tokens to include in a single request per document
LLM_MAX_CONTEXT_TOKENS=3000

# Per-request timeout in seconds (Must be > 0.0)
LLM_TIMEOUT=60.0

# Retries on transient errors (429, 5xx, timeouts) (Must be >= 0)
LLM_NUM_RETRIES=3

# ==============================================================================
# Miscellaneous & Enhancement Settings
# ==============================================================================
# Minimum length of title+abstract that we might consider for classification
MIN_TEXT_LENGTH=500

# Visibility level for Enhancements
ENHANCEMENT_VISIBILITY=public

# If true, set BooleanAnnotation(value=False) for references that are not classified because of missing abstracts or chained prompts.
SET_UNSEEN_FALSE=true

# Defines the value to use for BooleanAnnotation.scheme for search queries
ANNOTATION_SCHEME_QUERY=query-inclusion

# Defines the value to use for BooleanAnnotation.scheme for inclusion classification
ANNOTATION_SCHEME_INCL=domain-inclusion

# Defines the value to use for BooleanAnnotation.label for search queries
ANNOTATION_LABEL_QUERY=destiny

# Defines the value to use for BooleanAnnotation.label for pre-filtering
ANNOTATION_LABEL_PREFILTER=destiny-prefilter

# Defines the value to use for BooleanAnnotation.label for high-recall LLM decisions
ANNOTATION_LABEL_RECALL=destiny-high-recall

# Defines the value to use for BooleanAnnotation.label for balanced LLM decisions
ANNOTATION_LABEL_BALANCED=destiny-balanced

# Defines the value to use for BooleanAnnotation.label for high-precision LLM decisions
ANNOTATION_LABEL_PRECISION=destiny-high-precision